{
  "nov-xs-session-context": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File .specify/scripts/powershell/agent-hook-handler.ps1 -Event SessionStart",
        "timeout": 10
      }
    ]
  },
  "nov-xs-post-edit": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .specify/scripts/powershell/agent-hook-handler.ps1 -Event PostToolUse",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
