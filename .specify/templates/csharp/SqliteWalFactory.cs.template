using System.Data.Common;

namespace __PROJECT_NAME__.Infrastructure;

/// <summary>
/// Zero-Ops SQLite WAL connection initializer for Medium-Scale (<10M rows) persistence.
/// Requires package: Microsoft.Data.Sqlite
/// </summary>
public static class SqliteWalInitializer
{
    public const string PragmasSql = """
        PRAGMA journal_mode = WAL;
        PRAGMA synchronous = NORMAL;
        PRAGMA busy_timeout = 5000;
        PRAGMA foreign_keys = ON;
        """;

    public static async Task InitializeWalAsync(DbConnection connection, CancellationToken ct = default)
    {
        if (connection.State != System.Data.ConnectionState.Open)
        {
            await connection.OpenAsync(ct);
        }

        await using var cmd = connection.CreateCommand();
        cmd.CommandText = PragmasSql;
        await cmd.ExecuteNonQueryAsync(ct);
    }
}
