using System.Text.Json;

namespace __PROJECT_NAME__.Infrastructure;

public interface IJsonStore<T> where T : class
{
    T Read();
    void Write(T data);
    T Update(Func<T, T> mutator);
}

public sealed class AtomicJsonStore<T>(string filePath, Func<T> defaultFactory, JsonSerializerOptions? options = null) : IJsonStore<T>
    where T : class
{
    private readonly Lock _sync = new();
    private readonly JsonSerializerOptions _jsonOptions = options ?? new(JsonSerializerDefaults.Web) { WriteIndented = true };

    public T Read()
    {
        lock (_sync)
        {
            return ReadUnsafe();
        }
    }

    public void Write(T data)
    {
        lock (_sync)
        {
            WriteUnsafe(data);
        }
    }

    public T Update(Func<T, T> mutator)
    {
        lock (_sync)
        {
            var current = ReadUnsafe();
            var updated = mutator(current);
            WriteUnsafe(updated);
            return updated;
        }
    }

    private T ReadUnsafe()
    {
        if (!File.Exists(filePath))
        {
            var seed = defaultFactory();
            WriteUnsafe(seed);
            return seed;
        }

        try
        {
            var raw = File.ReadAllText(filePath);
            return JsonSerializer.Deserialize<T>(raw, _jsonOptions) ?? defaultFactory();
        }
        catch (JsonException)
        {
            return defaultFactory();
        }
    }

    private void WriteUnsafe(T data)
    {
        var dir = Path.GetDirectoryName(filePath);
        if (!string.IsNullOrEmpty(dir))
        {
            Directory.CreateDirectory(dir);
        }

        var tmpPath = $"{filePath}.{Guid.NewGuid():N}.tmp";
        var json = JsonSerializer.Serialize(data, _jsonOptions);
        File.WriteAllText(tmpPath, json);
        File.Move(tmpPath, filePath, overwrite: true);
    }
}
