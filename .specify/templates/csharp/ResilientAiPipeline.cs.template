using System.Runtime.CompilerServices;
using System.Text.Json;
using System.Text.Json.Nodes;
using Microsoft.Extensions.AI;

namespace __PROJECT_NAME__.Infrastructure;

/// <summary>
/// Deterministic offline/test IChatClient fallback that guarantees 100% testability
/// and offline resilience for plain text, streaming, and GetResponseAsync&lt;T&gt;() structured outputs.
/// </summary>
public sealed class DeterministicFallbackChatClient : IChatClient
{
    private readonly ChatClientMetadata _metadata = new("DeterministicFallback", new Uri("http://localhost"), "offline-v1");

    public Task<ChatResponse> GetResponseAsync(
        IEnumerable<ChatMessage> messages,
        ChatOptions? options = null,
        CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        var lastUserText = messages.LastOrDefault(m => m.Role == ChatRole.User)?.Text?.Trim() ?? string.Empty;

        var content = options?.ResponseFormat is ChatResponseFormatJson jsonFormat
            ? BuildStructuredJson(jsonFormat.Schema, lastUserText)
            : $"[Fallback Response] Processed: {lastUserText}";

        var reply = new ChatMessage(ChatRole.Assistant, content);
        return Task.FromResult(new ChatResponse([reply]) { ModelId = "offline-v1" });
    }

    public async IAsyncEnumerable<ChatResponseUpdate> GetStreamingResponseAsync(
        IEnumerable<ChatMessage> messages,
        ChatOptions? options = null,
        [EnumeratorCancellation] CancellationToken cancellationToken = default)
    {
        var response = await GetResponseAsync(messages, options, cancellationToken);
        foreach (var word in (response.Text ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            cancellationToken.ThrowIfCancellationRequested();
            yield return new ChatResponseUpdate(ChatRole.Assistant, $"{word} ");
        }
    }

    public object? GetService(Type serviceType, object? serviceKey = null) =>
        serviceType == typeof(ChatClientMetadata) ? _metadata :
        serviceType.IsInstanceOfType(this) ? this : null;

    public void Dispose() { }

    private static string BuildStructuredJson(JsonElement? schema, string prompt)
    {
        if (schema is not { ValueKind: JsonValueKind.Object } root ||
            !root.TryGetProperty("properties", out var props) ||
            props.ValueKind != JsonValueKind.Object)
        {
            return "{}";
        }

        var obj = new JsonObject();
        foreach (var prop in props.EnumerateObject())
        {
            obj[prop.Name] = CreateDefaultNode(prop.Value, prompt);
        }

        return obj.ToJsonString();
    }

    private static JsonNode? CreateDefaultNode(JsonElement propSchema, string prompt)
    {
        var typeName = "string";
        if (propSchema.ValueKind == JsonValueKind.Object && propSchema.TryGetProperty("type", out var t))
        {
            typeName = t.ValueKind == JsonValueKind.Array
                ? t.EnumerateArray().FirstOrDefault(x => x.GetString() != "null").GetString() ?? "string"
                : t.GetString() ?? "string";
        }

        return typeName switch
        {
            "integer" or "number" => JsonValue.Create(0),
            "boolean" => JsonValue.Create(false),
            "array" => new JsonArray(),
            "object" => new JsonObject(),
            _ => JsonValue.Create($"[Fallback] {prompt}")
        };
    }
}
