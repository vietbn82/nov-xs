using System.Text.Json;
using Microsoft.Data.Sqlite;

namespace __PROJECT_NAME__.Infrastructure;

public interface ISqliteConnectionFactory
{
    Task<SqliteConnection> OpenConnectionAsync(CancellationToken ct = default);
}

/// <summary>
/// Zero-Ops SQLite WAL Engine. Automatically enables WAL concurrency pragmas and
/// initializes the hybrid document/relational schema on first access with zero migrations.
/// </summary>
public sealed class SqliteConnectionFactory : ISqliteConnectionFactory
{
    private readonly string _connectionString;
    private readonly SemaphoreSlim _initLock = new(1, 1);
    private volatile bool _initialized;

    public SqliteConnectionFactory(string databaseFilePath)
    {
        var dir = Path.GetDirectoryName(databaseFilePath);
        if (!string.IsNullOrEmpty(dir))
        {
            Directory.CreateDirectory(dir);
        }

        _connectionString = new SqliteConnectionStringBuilder
        {
            DataSource = databaseFilePath,
            Mode = SqliteOpenMode.ReadWriteCreate,
            Pooling = true
        }.ToString();
    }

    public async Task<SqliteConnection> OpenConnectionAsync(CancellationToken ct = default)
    {
        var connection = new SqliteConnection(_connectionString);
        await connection.OpenAsync(ct);

        await using (var pragmaCmd = connection.CreateCommand())
        {
            pragmaCmd.CommandText = """
                PRAGMA journal_mode = WAL;
                PRAGMA synchronous = NORMAL;
                PRAGMA busy_timeout = 5000;
                PRAGMA foreign_keys = ON;
                """;
            await pragmaCmd.ExecuteNonQueryAsync(ct);
        }

        if (!_initialized)
        {
            await _initLock.WaitAsync(ct);
            try
            {
                if (!_initialized)
                {
                    await using var schemaCmd = connection.CreateCommand();
                    schemaCmd.CommandText = """
                        CREATE TABLE IF NOT EXISTS slice_items (
                            slice TEXT NOT NULL,
                            id TEXT NOT NULL,
                            payload_json TEXT NOT NULL,
                            updated_at_utc TEXT NOT NULL,
                            PRIMARY KEY (slice, id)
                        );
                        CREATE INDEX IF NOT EXISTS idx_slice_items_updated
                            ON slice_items (slice, updated_at_utc DESC);
                        """;
                    await schemaCmd.ExecuteNonQueryAsync(ct);
                    _initialized = true;
                }
            }
            finally
            {
                _initLock.Release();
            }
        }

        return connection;
    }
}

public interface ISliceStore<T> where T : class
{
    Task<IReadOnlyList<T>> GetAllAsync(CancellationToken ct = default);
    Task<T?> GetByIdAsync(string id, CancellationToken ct = default);
    Task<T> UpsertAsync(string id, T item, CancellationToken ct = default);
    Task<bool> DeleteAsync(string id, CancellationToken ct = default);
}

/// <summary>
/// Schema-agnostic Vertical Slice store backed by SQLite WAL + JSON serialization.
/// Eliminates EF Core migration friction while preserving ACID transactions and SQL queryability.
/// </summary>
public sealed class SqliteSliceStore<T>(
    ISqliteConnectionFactory db,
    string sliceName,
    JsonSerializerOptions? jsonOptions = null) : ISliceStore<T>
    where T : class
{
    private readonly JsonSerializerOptions _options = jsonOptions ?? new(JsonSerializerDefaults.Web);

    public async Task<IReadOnlyList<T>> GetAllAsync(CancellationToken ct = default)
    {
        await using var conn = await db.OpenConnectionAsync(ct);
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = """
            SELECT payload_json
            FROM slice_items
            WHERE slice = $slice
            ORDER BY updated_at_utc DESC;
            """;
        cmd.Parameters.AddWithValue("$slice", sliceName);

        var results = new List<T>();
        await using var reader = await cmd.ExecuteReaderAsync(ct);
        while (await reader.ReadAsync(ct))
        {
            var json = reader.GetString(0);
            if (JsonSerializer.Deserialize<T>(json, _options) is { } item)
            {
                results.Add(item);
            }
        }

        return results;
    }

    public async Task<T?> GetByIdAsync(string id, CancellationToken ct = default)
    {
        await using var conn = await db.OpenConnectionAsync(ct);
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = """
            SELECT payload_json
            FROM slice_items
            WHERE slice = $slice AND id = $id
            LIMIT 1;
            """;
        cmd.Parameters.AddWithValue("$slice", sliceName);
        cmd.Parameters.AddWithValue("$id", id);

        var raw = await cmd.ExecuteScalarAsync(ct) as string;
        return raw is null ? null : JsonSerializer.Deserialize<T>(raw, _options);
    }

    public async Task<T> UpsertAsync(string id, T item, CancellationToken ct = default)
    {
        var json = JsonSerializer.Serialize(item, _options);
        var now = DateTimeOffset.UtcNow.ToString("O");

        await using var conn = await db.OpenConnectionAsync(ct);
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = """
            INSERT INTO slice_items (slice, id, payload_json, updated_at_utc)
            VALUES ($slice, $id, $json, $now)
            ON CONFLICT(slice, id) DO UPDATE SET
                payload_json = excluded.payload_json,
                updated_at_utc = excluded.updated_at_utc;
            """;
        cmd.Parameters.AddWithValue("$slice", sliceName);
        cmd.Parameters.AddWithValue("$id", id);
        cmd.Parameters.AddWithValue("$json", json);
        cmd.Parameters.AddWithValue("$now", now);

        await cmd.ExecuteNonQueryAsync(ct);
        return item;
    }

    public async Task<bool> DeleteAsync(string id, CancellationToken ct = default)
    {
        await using var conn = await db.OpenConnectionAsync(ct);
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = """
            DELETE FROM slice_items
            WHERE slice = $slice AND id = $id;
            """;
        cmd.Parameters.AddWithValue("$slice", sliceName);
        cmd.Parameters.AddWithValue("$id", id);

        var rows = await cmd.ExecuteNonQueryAsync(ct);
        return rows > 0;
    }
}
